{
  "name": "@collana-solutions/react-formik-ui",
  "version": "2.1.2",
  "description": "Common Form Elements",
  "homepage": "https://github.com/collana-solutions/react-formik-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collana-solutions/react-formik-ui"
  },
  "license": "MIT",
  "author": "collana solutions AG",
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "shx rm -rf dist && microbundle --jsx React.createElement --jsxFragment React.Fragment --jsxImportSource react --globals react/jsx-runtime=jsx --no-compress --tsconfig ./tsconfig.microbundle.json",
    "build-storybook": "cross-env NODE_OPTIONS=--openssl-legacy-provider build-storybook",
    "lint": "eslint \"**/*.{ts,tsx}\" --cache --max-warnings 0",
    "prepack": "pnpm run build",
    "prepare-pr": "pnpm exec prettier . --write && pnpm run lint && pnpm run build && pnpm run test",
    "prettier-check": "prettier --check .",
    "prettier-write": "prettier --write .",
    "start": "microbundle watch --jsx React.createElement --jsxFragment React.Fragment --jsxImportSource react --globals react/jsx-runtime=jsx --no-compress --tsconfig ./tsconfig.microbundle.json",
    "start-all": "concurrently \"pnpm run start\" \"pnpm run start-yalc\"",
    "start-yalc": "nodemon --watch dist -x \"yalc push\"",
    "storybook": "cross-env NODE_OPTIONS=--openssl-legacy-provider start-storybook -p 6006",
    "test": "cross-env DEBUG_PRINT_LIMIT=100 jest",
    "tsc": "tsc",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "react-datepicker": "^9.1.0",
    "react-number-format": "^5.4.5"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/react": "^10.6.6",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^19.3.0",
    "@types/reactstrap": "^8.7.2",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-loader": "^10.1.1",
    "bootstrap": "^5.3.8",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.14.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-react": "^13.0.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.23.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-storybook": "^10.6.6",
    "formik": "^2.2.6",
    "jest": "^30.5.2",
    "microbundle": "^0.15.0",
    "nodemon": "^3.1.14",
    "pkg-pr-new": "^0.0.93",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reactstrap": "^9.2.3",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "formik": "^2.2.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reactstrap": "^9.2.3"
  },
  "engines": {
    "node": ">=14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.22.0"
}
